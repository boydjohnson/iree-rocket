# Cargo (workspace-wide; Cargo.lock is committed for reproducible cross-builds)
/target/

# rocket-schema build artifacts (generated/rust is checked in; generated/c and build/ are not)
/rocket-schema/build/
/rocket-schema/generated/c/

# CMake build output (regenerated by the presets in CMakePresets.json)
/iree-build/build/
/iree-build/host/build/
/iree-build/host-aarch64/build/
/iree-build/host/build-aarch64/

# lit test run artifacts
.lit_test_times.txt
/rocket-compiler-plugin/test/Output/
/rocket-compiler-plugin/test/Testing/
__pycache__/

# Model survey artifacts: ONNX exports, imported MLIR, .vmfb arms and board
# results. Gigabytes per model, and none of it is reproducible-by-commit --
# tools/model_survey.py rebuilds it from tools/export_onnx.py's registry.
/survey/
/.venv/
