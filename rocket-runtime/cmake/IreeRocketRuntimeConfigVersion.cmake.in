# Any 0.x release is only compatible with itself: the API is not stable yet,
# and every release is pinned to one IREE version (see rocket/runtime.h).
set(PACKAGE_VERSION "@ROCKET_RUNTIME_VERSION@")
if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  set(PACKAGE_VERSION_EXACT TRUE)
elseif(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
else()
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
endif()
