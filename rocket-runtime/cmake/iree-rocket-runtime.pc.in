prefix=${pcfiledir}/../..
libdir=${prefix}/lib
includedir=${prefix}/include

Name: iree-rocket-runtime
Description: IREE runtime with the Rocket (RK3588 NPU) HAL driver, shared library
Version: @ROCKET_RUNTIME_VERSION@
Libs: -L${libdir} -liree_rocket_runtime
Cflags: -I${includedir} @_PUBLIC_CFLAGS@
