prefix=${pcfiledir}/../..
libdir=${prefix}/lib
includedir=${prefix}/include

# C and C++ only: the archive carries the Rocket driver's own Rust standard
# library. Named by path so the linker cannot pick the .so beside it instead.
Name: iree-rocket-runtime-static
Description: IREE runtime with the Rocket (RK3588 NPU) HAL driver, static archives
Version: @ROCKET_RUNTIME_VERSION@
Libs: ${libdir}/libiree_rocket_runtime.a @_STATIC_SYSTEM_LIBS@
Cflags: -I${includedir} @_PUBLIC_CFLAGS@
