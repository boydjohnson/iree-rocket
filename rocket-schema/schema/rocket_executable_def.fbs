namespace iree.hal.rocket;

// Rocket executable schema, major version 1.
file_identifier "RKT1";
file_extension "rkt1";

// Wire-format values. These are independent of hardware register encodings.
enum Precision : ubyte {
  INT8 = 0,
  FP16 = 1,
  // Signed int8 inputs/weights with the exact signed int32 convolution
  // accumulator written as the output tensor.
  INT8_ACCUMULATOR = 2,
}

// Wire-format values. RELUX uses the selected kernel definition's
// activation_cmp field.
enum Activation : ubyte {
  NONE = 0,
  RELU = 1,
  RELUX = 2,
}

// Conv2D shape fields that may be supplied by dispatch push constants.
// Numeric values are wire-format ABI and must not be changed or reused.
//
// Values 3 and 4 are retired and must never be reused: they were
// OUTPUT_WIDTH/OUTPUT_HEIGHT, which the runtime always derives from the
// six settable dimensions plus stride and padding. Making them
// independently settable would allow a dispatch to state an output shape
// inconsistent with the one the register commands are actually built for,
// so both the serializer and the runtime reject them outright.
enum Conv2DDimension : ubyte {
  INPUT_WIDTH = 0,
  INPUT_HEIGHT = 1,
  INPUT_CHANNELS = 2,
  OUTPUT_CHANNELS = 5,
  WEIGHTS_WIDTH = 6,
  WEIGHTS_HEIGHT = 7,
}

// Wire-format values, independent of the PPU's register encoding.
//
// There is deliberately no SUM. The PPU has no sum mode: its average is a
// multiply by a per-axis reciprocal held as fp16(65536/k), so a divisor of
// one would need 65536, past fp16's 65504 ceiling. MLIR's linalg dialect has
// no average pool at all -- an ONNX AveragePool arrives as
// linalg.pooling_*_sum followed by a separate divide -- so recognizing that
// pair as an average is the compiler's job. A SUM value here would be a wire
// state the runtime could not execute.
enum PoolingMethod : ubyte {
  AVG = 0,
  MAX = 1,
  MIN = 2,
}

// Pooling shape fields that may be supplied by dispatch push constants.
// Numeric values are wire-format ABI and must not be changed or reused.
//
// Padding is deliberately absent: it is 0..=7 on this hardware, its meaning
// depends on the pooling method, and no measured model varies it per
// dispatch. It stays an executable property.
enum PoolingDimension : ubyte {
  INPUT_WIDTH = 0,
  INPUT_HEIGHT = 1,
  CHANNELS = 2,
  KERNEL_WIDTH = 3,
  KERNEL_HEIGHT = 4,
  STRIDE_X = 5,
  STRIDE_Y = 6,
}

// Wire-format values, independent of the EW ALU's `ew_alu_algo` register
// encoding. Keeping them independent is not only convention here: the
// conv+add sweep found real rknn-toolkit2 compiles route int8 subtraction as
// `algo = 2` (Add) with a negated scale rather than `algo = 4`, so the
// register opcode is genuinely not a function of the logical operation alone.
//
// Split into unary and binary rather than one EwOp list, for the same reason
// PoolingMethod has no SUM: a single list spanning both tables would let a
// producer name ADD in an ElementwiseUnaryDef, which is a wire state the
// runtime could not execute. Each enum is closed over what its own table can
// actually run.
enum EwUnaryOp : ubyte {
  ABS = 0,
  NEG = 1,
  FLOOR = 2,
  CEIL = 3,
  // x + operand, with the scalar in ElementwiseUnaryDef.operand. Named
  // separately from the binary ADD because it is a different table and a
  // different operand source (EW_OP_VALUE_0, not a second tensor).
  ADD_SCALAR = 4,
}

// Wire-format values for the two-tensor EW ops.
//
// There is deliberately no DIV. `ew_alu_algo = 3` is the one TRM-documented
// binary opcode with no hardware evidence behind it anywhere in this project,
// and iree-rocket-hal's EwBinaryOp does not carry it either.
enum EwBinaryOp : ubyte {
  ADD = 0,
  SUB = 1,
  MUL = 2,
  MAX = 3,
  MIN = 4,
}

// Which LUT curve an ElementwiseLutDef selects. Wire-format values, unrelated
// to table content or to the per-function BN scale constant each curve
// carries in iree-rocket-hal's LutTable.
enum LutFn : ubyte {
  SIGMOID = 0,
  TANH = 1,
  EXP = 2,
  SQUARE = 3,
  ERF = 4,
  SQRT = 5,
  RSQRT = 6,
  LOG = 7,
  RECIPROCAL = 8,
}

// Element-wise shape fields that may be supplied by dispatch push constants,
// shared by ElementwiseUnaryDef and ElementwiseLutDef. Numeric values are
// wire-format ABI and must not be changed or reused.
//
// These ops have no reduction: input and output geometry are identical, so
// one list covers both ends and there is no output extent to disagree with.
enum ElementwiseDimension : ubyte {
  WIDTH = 0,
  HEIGHT = 1,
  CHANNELS = 2,
}

// Matmul shape fields that may be supplied by dispatch push constants.
// Numeric values are wire-format ABI and must not be changed or reused.
enum MatmulDimension : ubyte {
  M = 0,
  K = 1,
  N = 2,
}

// Conv2D quantization fields that may be supplied by dispatch push constants.
// Numeric values are wire-format ABI and must not be changed or reused.
//
// These are deliberately a separate list from Conv2DDimension. A runtime
// *dimension* is rejected when a dispatch supplies zero, because no extent of
// a real convolution is zero and a zero there means the adapter failed to
// push it. Zero is a perfectly ordinary quantization value -- a symmetric
// tensor has zero point zero -- so these need the opposite rule, and mixing
// them into one list would have to weaken the dimension check.
//
// Each entry consumes one uint32 push constant, ordered after every
// runtime_dimensions constant. The payload is a bit pattern, not a number:
// OUTPUT_SCALE carries the IEEE-754 binary32 encoding of the scale and the
// zero points carry the two's-complement encoding of an int32, so a negative
// zero point survives the uint32 field. Both sides read the convention from
// this comment; rocket-hal-driver's `RuntimeConv2dQuantParam` and
// RocketTarget.cpp's serializer are the two implementations of it.
enum Conv2DQuantParam : ubyte {
  OUTPUT_SCALE = 0,
  INPUT_ZERO_POINT = 1,
  OUTPUT_ZERO_POINT = 2,
}

// Describes one NHWC/HWCF 2-D convolution.
//
// Version 1 has one stride because the current Rocket ConvShape and register
// command path require equal height and width strides. Dilation is implicitly
// 1. The runtime must reject operations that do not satisfy those constraints.
table Conv2DDef {
  input_width:uint32;
  input_height:uint32;
  input_channels:uint32;

  output_width:uint32;
  output_height:uint32;
  output_channels:uint32;

  weights_width:uint32;
  weights_height:uint32;

  stride:uint32;
  depthwise:bool = false;

  input_zero_point:uint32;
  output_zero_point:uint32;
  weights_zero_point:uint32;

  input_scale:float = 1.0;
  weights_scale:float = 1.0;
  output_scale:float = 1.0;

  truncate_bits:uint32;
  activation:Activation = NONE;

  // Only meaningful when activation is RELUX.
  activation_cmp:uint32;

  precision:Precision = INT8;

  // Ordered list mapping dispatch push-constant ordinal to a shape field.
  // Each entry consumes one uint32 push constant. A listed field must be zero
  // in this table and is replaced by the nonzero dispatch value before runtime
  // semantic validation and register-command construction. Entries must be
  // unique. An absent/empty vector preserves the original fully-static ABI.
  runtime_dimensions:[Conv2DDimension];

  // Symmetric spatial padding. These fields are deliberately appended for
  // FlatBuffers compatibility: older RKT1 binaries omit them and read as
  // unpadded. `pad_top` is also applied below the input and `pad_left` is
  // also applied to its right, matching Rocket ConvShape's current
  // two-value padding model.
  pad_top:uint32;
  pad_left:uint32;

  // Ordered list mapping dispatch push-constant ordinal to a quantization
  // field, continuing the push-constant sequence after runtime_dimensions.
  // A listed field must hold its default in this table and is replaced by the
  // dispatch value -- including zero -- before the multiplier is derived.
  // Entries must be unique. Appended last, like pad_top/pad_left above and
  // for the same reason: a field added mid-table would shift every later
  // field's vtable slot.
  runtime_quantization:[Conv2DQuantParam];
}

// DEPRECATED: superseded by MatmulDef. Retained because union tags are
// wire-format ABI and must not be reused, and because a runtime may still
// meet an older executable that carries one.
//
// No compiler has ever emitted this table. "Fully connected" is not an
// operation in MLIR's linalg dialect, which is what IREE hands this backend;
// what actually arrives is linalg.matmul. MatmulDef is that operation, with
// the runtime_dimensions support this table never had.
//
// Describes one row-major [M,K] x [K,N] fully-connected operation.
//
// The runtime lowers this to the NPU's 1x1-convolution path. The fixed
// physical-height padding required by that lowering is a runtime storage
// detail and is deliberately not part of the logical executable ABI.
table FullyConnectedDef {
  m:uint32;
  k:uint32;
  n:uint32;

  input_zero_point:uint32;
  output_zero_point:uint32;
  weights_zero_point:uint32;

  input_scale:float = 1.0;
  weights_scale:float = 1.0;
  output_scale:float = 1.0;

  truncate_bits:uint32;
  activation:Activation = NONE;

  // Only meaningful when activation is RELUX.
  activation_cmp:uint32;

  precision:Precision = INT8;
}

// Describes one standalone PPU pooling operation.
//
// A pool is a self-contained PPU + PPU_RDMA job: it reads the NC1HWC2 input
// cube, reduces each window per channel, and writes the output cube in the
// same layout. No convolution block participates, so there are no weights,
// no bias, and no quantization parameters -- the reduction carries its
// operand format through unchanged.
//
// The pad fill value is deliberately not on the wire. It is the reduction's
// identity element, which follows from `method` and `precision` alone, and a
// producer that could state it independently could silently change a max
// pool's answer at the border by sending zero.
table PoolingDef {
  input_width:uint32;
  input_height:uint32;

  // Pooling preserves the channel count, so this is one field rather than
  // an input/output pair that could disagree with itself.
  channels:uint32;

  // Carried and re-derived by the runtime, matching Conv2DDef. An executable
  // whose stated output does not match floor-mode geometry is rejected.
  output_width:uint32;
  output_height:uint32;

  kernel_width:uint32;
  kernel_height:uint32;
  stride_x:uint32;
  stride_y:uint32;

  pad_left:uint32;
  pad_top:uint32;
  pad_right:uint32;
  pad_bottom:uint32;

  method:PoolingMethod = MAX;
  precision:Precision = INT8;

  // Ordered list mapping dispatch push-constant ordinal to a shape field,
  // with the same contract as Conv2DDef.runtime_dimensions: each entry
  // consumes one uint32 push constant, the listed field must be zero in this
  // table, entries must be unique, and an absent vector preserves a fully
  // static ABI.
  runtime_dimensions:[PoolingDimension];
}

// Describes one row-major [M,K] x [K,N] -> [M,N] matmul.
//
// This is the operation IREE actually delivers (linalg.matmul); it replaces
// FullyConnectedDef, which named something the linalg dialect does not have.
// The runtime lowers it to the NPU's 1x1-convolution path, where M is the
// convolution width at height one, K is the input channel count and N the
// output channel count.
//
// Operands are row-major and untransposed: A is [M,K] and B is [K,N]. A
// linalg.matmul carrying non-default indexing_maps expresses a transpose or
// broadcast, which is a different memory layout, and the compiler must
// decline it rather than encode it here.
table MatmulDef {
  m:uint32;
  k:uint32;
  n:uint32;

  input_zero_point:uint32;
  output_zero_point:uint32;
  weights_zero_point:uint32;

  input_scale:float = 1.0;
  weights_scale:float = 1.0;
  output_scale:float = 1.0;

  truncate_bits:uint32;
  activation:Activation = NONE;

  // Only meaningful when activation is RELUX.
  activation_cmp:uint32;

  precision:Precision = INT8;

  // Same contract as Conv2DDef.runtime_dimensions.
  runtime_dimensions:[MatmulDimension];
}

// Describes one standalone unary element-wise operation on the EW ALU.
//
// A self-contained DPU + DPU_RDMA job: it reads the NC1HWC2 input cube,
// applies one ALU opcode per element, and writes the output cube with
// identical geometry. No convolution block participates, so there are no
// weights, no bias and no reduction.
//
// fp16 only, and there is deliberately no precision field. iree-rocket-hal's
// EwUnaryShape carries no int8 branch: unlike the two-tensor path, no capture
// exists confirming an int8 zero-point/scale recipe for this task shape, and
// this project does not ship an int8 branch with no hardware evidence behind
// it. A precision field here would be a wire state the runtime must refuse.
// If an int8 recipe is ever established, appending the field then is the
// FlatBuffers-compatible move; declaring it now is not.
table ElementwiseUnaryDef {
  width:uint32;
  height:uint32;

  // The operation is elementwise, so input and output channel counts are
  // necessarily equal and this is one field rather than a pair that could
  // disagree with itself -- the same reasoning as PoolingDef.channels.
  channels:uint32;

  op:EwUnaryOp = ABS;

  // Only meaningful when op is ADD_SCALAR: the scalar operand as
  // `f32::to_bits`, an IEEE-754 binary32 bit pattern rather than a number,
  // matching Conv2DQuantParam's stated convention for bit-pattern payloads.
  // The EW ALU's datapath upconverts fp16 to fp32 internally, which is why
  // the operand register is fed a binary32 encoding. Must be zero for every
  // other op, which the runtime enforces.
  operand:uint32;

  // Ordered list mapping dispatch push-constant ordinal to a shape field,
  // with the same contract as Conv2DDef.runtime_dimensions: each entry
  // consumes one uint32 push constant, the listed field must be zero in this
  // table, entries must be unique, and an absent vector preserves a fully
  // static ABI.
  runtime_dimensions:[ElementwiseDimension];
}

// Describes one standalone two-tensor element-wise operation on the EW
// datapath.
//
// A self-contained DPU + DPU_RDMA job: DPU_RDMA fetches the primary operand
// through its ordinary main feed, ERDMA fetches the second tensor, EW
// combines them element by element, and the result is written with identical
// geometry. Both operands and the result are the same shape -- this op does
// not broadcast, and a producer that wants broadcasting must materialize it.
//
// fp16 only, and deliberately no precision field, for a narrower reason than
// ElementwiseUnaryDef's. iree-rocket-hal's EwAddShape does carry an int8
// branch, but its EW_CVT_SCALE/OUT_CVT_SCALE ratio semantics are INFERRED
// from register shape rather than confirmed against a known value -- the
// builder's own doc comments say so -- and MUL has no int8 recipe in any
// capture at all. Putting the int8 fields on the wire would ship that
// inference as an ABI. Appending `precision` and the int8 scale fields once
// a capture confirms them is the FlatBuffers-compatible move.
table ElementwiseBinaryDef {
  width:uint32;
  height:uint32;
  channels:uint32;

  op:EwBinaryOp = ADD;

  // Same contract as ElementwiseUnaryDef.runtime_dimensions.
  runtime_dimensions:[ElementwiseDimension];
}

// Describes one standalone LUT activation: `out = f(in)` for one of the
// curves in LutFn, evaluated by the DPU's 513-entry interpolated hybrid
// LE/LO table.
//
// Like ElementwiseUnaryDef this is a self-contained DPU + DPU_RDMA job with
// identical input and output geometry. It is deliberately NOT fused into a
// convolution's own DPU pass: live tracing of the vendor runtime showed
// conv -> sigmoid/tanh really is a separate task reading the conv's output
// back from memory, and iree-rocket-hal models it that way.
//
// int8 only, and there is deliberately no precision field, for the mirror
// image of ElementwiseUnaryDef's reason: LutShape is quantized by
// construction -- the curve is evaluated on the dequantized real value, so
// the zero points and scales below are not optional metadata but how the
// input reaches the table's fixed domain at all.
table ElementwiseLutDef {
  width:uint32;
  height:uint32;
  channels:uint32;

  fn:LutFn = SIGMOID;

  // Decoded (real) zero points, as the two's-complement encoding of an int32
  // in a uint32 -- the convention Conv2DQuantParam documents, so a negative
  // zero point survives the field. NOT the 0x80-biased raw register form
  // LutShape happens to take; the runtime applies that bias.
  //
  // iree-rocket-hal only supports decoded input zero points of -128, -2, 0
  // and 127, which is what its captures confirm the BN_ALU formula against.
  // The runtime rejects anything else rather than programming an unverified
  // operand.
  input_zero_point:uint32;
  output_zero_point:uint32;

  input_scale:float = 1.0;
  output_scale:float = 1.0;

  // Same contract as ElementwiseUnaryDef.runtime_dimensions.
  runtime_dimensions:[ElementwiseDimension];
}

// Add future Rocket kernel kinds here. Existing numeric values must not be
// changed or reused -- a union tag is wire-format ABI, which is why the
// deprecated FullyConnectedDef keeps its place.
union KernelDef {
  Conv2DDef,
  FullyConnectedDef,
  PoolingDef,
  MatmulDef,
  ElementwiseUnaryDef,
  ElementwiseLutDef,
  ElementwiseBinaryDef,
}

// Information about one exported kernel.
table ExportDef {
  // Diagnostic symbol name. Dispatch selects exports by ordinal.
  name:string (required);

  kernel:KernelDef (required);
}

table ExecutableDef {
  // Exports in canonical IREE executable ordinal order.
  exports:[ExportDef] (required);
}

root_type ExecutableDef;
